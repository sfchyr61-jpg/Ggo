# ========================================
# إعدادات بوت الميوزك - قالب المتغيرات
# ========================================
# التعليمات:
# 1. انسخ هذا الملف وأعد تسميته إلى config.env
# 2. املأ القيم الفعلية الخاصة بك
# 3. لا ترفع config.env إلى GitHub أبداً
# ========================================

# معرف API - احصل عليه من https://my.telegram.org
API_ID=123456

# هاش API - من نفس الموقع
API_HASH=your_api_hash_here

# توكن البوت - من @BotFather
BOT_TOKEN=your_bot_token_here

# جلسة الحساب المساعد (بايروجرام)
STRING_SESSION=your_string_session_here

# ايديك الرقمي
OWNER_ID=123456789
